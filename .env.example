# Copy to .env. Never commit .env or share these values in chat.
LIFEHUB_USERNAME=owner
LIFEHUB_PASSWORD=
# Browser-facing origin, with no path. Production requires HTTPS.
LIFEHUB_PUBLIC_URL=http://localhost:8000
# Generate with the command in docs/bank-sync.md. Keep a private backup.
LIFEHUB_ENCRYPTION_KEY=
PLAID_ENV=sandbox
# Free Plaid Trial real-bank connections use PLAID_ENV=production and the
# Trial account's Production secret. This does not select a paid billing plan.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SYNC_INTERVAL_SECONDS=3600
